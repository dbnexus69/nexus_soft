/// Códigos de un solo uso para recuperar la contraseña.
///
/// No se guarda el código, sino su hash: la tabla no sirve para entrar en
/// ninguna cuenta ni para quien tenga acceso de lectura a la base. `intentos`
/// existe para que un código de seis cifras no se pueda adivinar a fuerza de
/// peticiones, e `usado_at` para que valga una sola vez.
model codigos_recuperacion {
  id          String    @id
  usuario_id  Int
  codigo_hash String
  expires_at  DateTime
  usado_at    DateTime?
  intentos    Int       @default(0)
  creado_at   DateTime  @default(now())
  usuarios    usuarios  @relation(fields: [usuario_id], references: [id])

  empresa_id       Int @default(dbgenerated("COALESCE(NULLIF(current_setting('app.empresa_id', true), '')::int, 1)"))
  empresas         empresas @relation(fields: [empresa_id], references: [id])

  @@index([empresa_id])
  @@index([usuario_id])
}

