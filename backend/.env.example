# ─────────────────────────────────────────────────────────────────────────────
# ENTORNO LOCAL (spec 038). Copia este archivo a `.env`: funciona tal cual.
# Todo aquí es de mentira y solo vale en tu máquina; nada apunta a producción.
#
#   docker compose up -d --wait     (desde la raíz del repo)
#   pnpm local:preparar             (desde backend/: migraciones, buckets, datos de prueba)
#
# Las variables de PRODUCCIÓN van en `backend/.env.produ` (sin versionar) y solo las usa
# `pnpm db:migrate:produ`. Render tiene las suyas en su panel. Ver README, "Base local".
# ─────────────────────────────────────────────────────────────────────────────

FRONTEND_URL=http://localhost:5173
PORT=3000
NODE_ENV=development

# La aplicación entra con `app_nexus`, sin BYPASSRLS, igual que en producción: con otro rol las
# políticas de aislamiento no filtran nada y `src/index.js` no arranca.
DATABASE_URL=postgresql://app_nexus:app_nexus@127.0.0.1:54329/nexus?connection_limit=10&pool_timeout=20

# Migraciones y `prisma generate --sql`: el dueño de la base.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54329/nexus

JWT_SECRET=clave-local-solo-para-desarrollo

# Los correos no salen: `emailService` los da por enviados.
EMAIL_SIMULADO=1
RESEND_API_KEY=""
EMAIL_FROM=""

# Búsqueda de vuelos en vivo (spec 039). Una sola clave, la paga DBNEXUS; nunca al frontend.
# Cuenta de prueba en https://www.searchapi.io
SEARCHAPI_KEY=""

# La API de Storage local del docker-compose, a través de su pasarela. La clave es la del
# `SERVICE_KEY` del compose (solo de desarrollo).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoibmV4dXMtbG9jYWwiLCJpYXQiOjE3OTM2MjMyNTUsImV4cCI6MjEwODk4MzI1NX0.VYQicYkZF7FZheTX_2m2wNHAP1N28zkaZ2IXWWH-k1s

# ─────────────────────────────────────────────────────────────────────────────
# Formato de `.env.produ` (no copies esto aquí, y nunca lo subas al repo):
#
# DATABASE_URL  rol `app_nexus.<ref>` en el POOLER de transacciones, puerto 6543, con
#               ?pgbouncer=true&connection_limit=10&pool_timeout=20. Nunca `postgres`: tiene
#               BYPASSRLS y las políticas dejarían de filtrar sin dar error.
# DIRECT_URL    `postgres.<ref>` en el pooler de SESIÓN, puerto 5432, sin esos parámetros. No
#               `db.<ref>.supabase.co`: solo responde por IPv6.
# SUPABASE_URL  https://<ref>.supabase.co, con su clave `service_role`, que no sale del backend.
# ─────────────────────────────────────────────────────────────────────────────

# DBeaver (base local). No la lee la app; DBeaver tampoco lee este archivo: se copian a su formulario de conexión.
DBEAVER_HOST=127.0.0.1
DBEAVER_PORT=54329
DBEAVER_DATABASE=nexus
DBEAVER_USER=postgres
DBEAVER_PASSWORD="postgres"
DBEAVER_SSL=disable
