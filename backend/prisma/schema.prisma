generator client {
  provider = "prisma-client-js"
  // relationJoins permite `relationLoadStrategy: 'join'`: resuelve un include
  // anidado con un solo JOIN lateral en vez de una consulta por nivel de
  // relación. En el listado de vuelos eran 11 viajes al pooler por página.
  previewFeatures = ["relationJoins", "typedSql"]
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
  relationMode = "foreignKeys"
}

model aerolineas {
  id                 Int                  @id @default(autoincrement())
  nombre             String
  codigo_iata        String?              @unique
  tipo               Cobertura            @default(Internacional)
  web                String?
  paquete_vuelo      paquete_vuelo[]
  politicas_equipaje politicas_equipaje[]
  prod_planes        prod_planes[]
  prod_tiqueteria    prod_tiqueteria[]
  tramos_vuelo       tramos_vuelo[]
}

model aeropuertos {
  id                                                           Int            @id @default(autoincrement())
  nombre                                                       String
  codigo_iata                                                  String         @unique
  ciudad                                                       String?
  pais                                                         String?
  tipo                                                         Cobertura      @default(Ambos)
  status                                                       UserStatus     @default(active)
  tramos_vuelo_tramos_vuelo_aeropuerto_destino_idToaeropuertos tramos_vuelo[] @relation("tramos_vuelo_aeropuerto_destino_idToaeropuertos")
  tramos_vuelo_tramos_vuelo_aeropuerto_origen_idToaeropuertos  tramos_vuelo[] @relation("tramos_vuelo_aeropuerto_origen_idToaeropuertos")
}

model clientes {
  id             Int       @id @default(autoincrement())
  persona_id     Int       @unique
  creado_por_id  Int?
  fecha_registro DateTime  @default(now())
  deleted_at     DateTime?
  usuarios       usuarios? @relation(fields: [creado_por_id], references: [id])
  personas       personas  @relation(fields: [persona_id], references: [id])
  ventas         ventas[]
  empresa_id       Int @default(dbgenerated("COALESCE(NULLIF(current_setting('app.empresa_id', true), '')::int, 1)"))
  empresas         empresas @relation(fields: [empresa_id], references: [id])

  @@index([empresa_id])
  // Necesario para que otras tablas puedan apuntar a esta fila con su empresa
  // dentro: sin este único, la clave ajena compuesta no se puede crear.
  @@unique([id, empresa_id])
}

model comisionistas {
  id                     Int                      @id @default(autoincrement())
  persona_id             Int                      @unique
  tipo                   String?
  umbral_pago            Float?                   @default(0)
  acumulado              Float?                   @default(0)
  status                 AgentStatus              @default(Activo)
  banco                  String?
  tipo_cuenta            String?
  numero_cuenta          String?
  creado_at              DateTime                 @default(now())
  personas               personas                 @relation(fields: [persona_id], references: [id])
  liquidaciones_comision liquidaciones_comision[]
  ventas                 ventas[]
  empresa_id       Int @default(dbgenerated("COALESCE(NULLIF(current_setting('app.empresa_id', true), '')::int, 1)"))
  empresas         empresas @relation(fields: [empresa_id], references: [id])

  @@index([empresa_id])
  // Necesario para que otras tablas puedan apuntar a esta fila con su empresa
  // dentro: sin este único, la clave ajena compuesta no se puede crear.
  @@unique([id, empresa_id])
}

model detalle_venta {
  id                       String              @id
  venta_id                 Int
  categoria                ProductCategory
  nombre_servicio          String?
  subtotal                 Float?              @default(0)
  ta                       Float?              @default(0)
  costo_proveedor          Float?              @default(0)
  proveedor_id             Int?
  metodo_pago_proveedor_id Int?
  voucher_url              String?
  fecha_inicio_viaje       DateTime?
  fecha_fin_viaje          DateTime?
  origen                   String?
  destino                  String?
  observaciones            String?
  creado_at                DateTime?           @default(now())
  parentDetalleId          String?             @map("parent_detalle_id")
  metodos_pago             metodos_pago?       @relation(fields: [metodo_pago_proveedor_id], references: [id])
  proveedores              proveedores?        @relation(fields: [proveedor_id], references: [id])
  ventas                   ventas              @relation(fields: [venta_id], references: [id])
  parentDetalle            detalle_venta?      @relation("DetalleVentaHierarchy", fields: [parentDetalleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  childDetalles            detalle_venta[]     @relation("DetalleVentaHierarchy")
  pasajeros_detalle        pasajeros_detalle[]
  prod_autos               prod_autos?
  prod_checkins            prod_checkins?
  prod_eventos             prod_eventos?
  prod_fincas              prod_fincas?
  prod_hoteleria           prod_hoteleria?
  prod_mascotas            prod_mascotas?
  prod_migracion           prod_migracion?
  prod_pasaportes          prod_pasaportes?
  prod_planes              prod_planes?
  prod_restaurantes        prod_restaurantes?
  prod_seguros             prod_seguros?
  prod_simcards            prod_simcards?
  prod_tiqueteria          prod_tiqueteria?
  prod_tours               prod_tours?
  prod_visas               prod_visas?

  empresa_id       Int @default(dbgenerated("COALESCE(NULLIF(current_setting('app.empresa_id', true), '')::int, 1)"))
  empresas         empresas @relation(fields: [empresa_id], references: [id])

  @@index([empresa_id])
  @@index([metodo_pago_proveedor_id])
  @@index([proveedor_id])
  @@index([venta_id])
  // Necesario para que otras tablas puedan apuntar a esta fila con su empresa
  // dentro: sin este único, la clave ajena compuesta no se puede crear.
  @@unique([id, empresa_id])
}

/// Una agencia cliente. Todo lo que no sea catálogo del sistema pertenece a una.
///
/// Los colores se guardan en hexadecimal, que es lo que devuelve un selector de
/// color; el frontend los convierte a los canales que usa el tema
/// (`--primary-rgb: 43 45 66`). Solo se guarda el tono de marca: la variante
/// para modo oscuro se deriva, y cómo se deriva se decide en T9.
model empresas {
  id               Int              @id @default(autoincrement())
  /// Identifica la empresa en la URL. No puede chocar con las rutas de la
  /// aplicación, así que hay una lista de reservados al crearla.
  slug             String           @unique
  nombre           String
  nombre_comercial String?
  logo_url         String?
  color_primario   String?
  color_acento     String?
  color_realce     String?
  /// Remitente de sus correos. Hoy hay uno solo para todas, con el nombre
  /// escrito en el código: esto es lo que lo sustituye en T9.
  email_remitente  String?
  email_nombre     String?
  estado           EstadoEmpresa    @default(activa)
  creado_at        DateTime         @default(now())
  deleted_at       DateTime?
  suplantaciones   suplantaciones[]
  clientes                   clientes[]
  codigos_recuperacion       codigos_recuperacion[]
  comisionistas              comisionistas[]
  detalle_venta              detalle_venta[]
  liquidacion_ventas         liquidacion_ventas[]
  liquidaciones_comision     liquidaciones_comision[]
  logs_usuarios              logs_usuarios[]
  metodos_pago               metodos_pago[]
  pagos_venta                pagos_venta[]
  paquete_asistencia_medica  paquete_asistencia_medica[]
  paquete_hotel              paquete_hotel[]
  paquete_proveedor          paquete_proveedor[]
  paquete_tarifas            paquete_tarifas[]
  paquete_vuelo              paquete_vuelo[]
  paquetes                   paquetes[]
  pasajeros_detalle          pasajeros_detalle[]
  permisos_rol               permisos_rol[]
  personas                   personas[]
  prod_autos                 prod_autos[]
  prod_checkins              prod_checkins[]
  prod_eventos               prod_eventos[]
  prod_fincas                prod_fincas[]
  prod_hoteleria             prod_hoteleria[]
  prod_mascotas              prod_mascotas[]
  prod_migracion             prod_migracion[]
  prod_pasaportes            prod_pasaportes[]
  prod_planes                prod_planes[]
  prod_restaurantes          prod_restaurantes[]
  prod_seguros               prod_seguros[]
  prod_simcards              prod_simcards[]
  prod_tiqueteria            prod_tiqueteria[]
  prod_tours                 prod_tours[]
  prod_visas                 prod_visas[]
  proveedores                proveedores[]
  responsables               responsables[]
  roles                      roles[]
  sesiones                   sesiones[]
  tarjetas_agencia           tarjetas_agencia[]
  tramos_vuelo               tramos_vuelo[]
  usuarios                   usuarios[]
  ventas                     ventas[]
  ventas_mensuales           ventas_mensuales[]
}

enum EstadoEmpresa {
  activa
  suspendida
}

/// Cada vez que el superadmin entra en una empresa para dar soporte.
///
/// El superadmin no ve datos de negocio por defecto: para verlos tiene que
/// entrar, y entrar deja rastro. La entrada caduca (`expira_at`) en vez de ser
/// un permiso permanente, para que olvidarse de salir no equivalga a un acceso
/// abierto.
model suplantaciones {
  id            String    @id
  superadmin_id Int
  empresa_id    Int
  motivo        String
  iniciada_at   DateTime  @default(now())
  expira_at     DateTime
  terminada_at  DateTime?
  ip            String?
  empresas      empresas  @relation(fields: [empresa_id], references: [id])
  usuarios      usuarios  @relation(fields: [superadmin_id], references: [id])

  @@index([empresa_id])
  @@index([superadmin_id])
}

model liquidacion_ventas {
  id                     Int                    @id @default(autoincrement())
  liquidacion_id         Int
  venta_id               Int
  liquidaciones_comision liquidaciones_comision @relation(fields: [liquidacion_id], references: [id])
  ventas                 ventas                 @relation(fields: [venta_id], references: [id])

  empresa_id       Int @default(dbgenerated("COALESCE(NULLIF(current_setting('app.empresa_id', true), '')::int, 1)"))
  empresas         empresas @relation(fields: [empresa_id], references: [id])

  @@index([empresa_id])
  @@unique([liquidacion_id, venta_id])
}

model liquidaciones_comision {
  id                 Int                  @id @default(autoincrement())
  comisionista_id    Int
  fecha              DateTime
  monto              Float
  metodo_pago_id     Int?
  referencia         String?
  notas              String?
  creado_at          DateTime             @default(now())
  liquidacion_ventas liquidacion_ventas[]
  comisionistas      comisionistas        @relation(fields: [comisionista_id], references: [id])
  metodos_pago       metodos_pago?        @relation(fields: [metodo_pago_id], references: [id])
  empresa_id       Int @default(dbgenerated("COALESCE(NULLIF(current_setting('app.empresa_id', true), '')::int, 1)"))
  empresas         empresas @relation(fields: [empresa_id], references: [id])

  @@index([empresa_id])
  // Necesario para que otras tablas puedan apuntar a esta fila con su empresa
  // dentro: sin este único, la clave ajena compuesta no se puede crear.
  @@unique([id, empresa_id])
}

model logs_usuarios {
  id          Int      @id @default(autoincrement())
  usuario_id  Int
  accion      String?
  modulo      String?
  descripcion String?
  fecha       DateTime @default(now())
  usuarios    usuarios @relation(fields: [usuario_id], references: [id])
  empresa_id       Int @default(dbgenerated("COALESCE(NULLIF(current_setting('app.empresa_id', true), '')::int, 1)"))
  empresas         empresas @relation(fields: [empresa_id], references: [id])

  @@index([empresa_id])
}

model metodos_pago {
  id                     Int                      @id @default(autoincrement())
  nombre                 String
  detalle_venta          detalle_venta[]
  liquidaciones_comision liquidaciones_comision[]
  pagos_venta            pagos_venta[]
  tarjetas_agencia       tarjetas_agencia[]
  ventas                 ventas[]
  empresa_id       Int @default(dbgenerated("COALESCE(NULLIF(current_setting('app.empresa_id', true), '')::int, 1)"))
  empresas         empresas @relation(fields: [empresa_id], references: [id])

  @@unique([empresa_id, nombre])
  @@index([empresa_id])
  // Necesario para que otras tablas puedan apuntar a esta fila con su empresa
  // dentro: sin este único, la clave ajena compuesta no se puede crear.
  @@unique([id, empresa_id])
}

model pagos_venta {
  id             String        @id
  venta_id       Int
  monto          Float
  metodo_pago_id Int?
  referencia     String?
  fecha_pago     DateTime      @default(now())
  metodos_pago   metodos_pago? @relation(fields: [metodo_pago_id], references: [id])
  ventas         ventas        @relation(fields: [venta_id], references: [id])

  empresa_id       Int @default(dbgenerated("COALESCE(NULLIF(current_setting('app.empresa_id', true), '')::int, 1)"))
  empresas         empresas @relation(fields: [empresa_id], references: [id])

  @@index([empresa_id])
  @@index([venta_id])
}

model paquete_asistencia_medica {
  id             Int      @id @default(autoincrement())
  paquete_id     Int      @unique
  cobertura_usd  Float    @default(0)
  dias_cobertura Int      @default(0)
  paquetes       paquetes @relation(fields: [paquete_id], references: [id])
  empresa_id       Int @default(dbgenerated("COALESCE(NULLIF(current_setting('app.empresa_id', true), '')::int, 1)"))
  empresas         empresas @relation(fields: [empresa_id], references: [id])

  @@index([empresa_id])
}

model paquete_hotel {
  id           Int                 @id @default(autoincrement())
  paquete_id   Int
  hotel_nombre String
  tipo_hotel   TipoHotel?          @default(hotel)
  regimen      RegimenAlimenticio? @default(full)
  noches       Int?
  paquetes     paquetes            @relation(fields: [paquete_id], references: [id])
  empresa_id       Int @default(dbgenerated("COALESCE(NULLIF(current_setting('app.empresa_id', true), '')::int, 1)"))
  empresas         empresas @relation(fields: [empresa_id], references: [id])

  @@index([empresa_id])
}

model paquete_proveedor {
  id           Int         @id @default(autoincrement())
  paquete_id   Int
  proveedor_id Int
  paquetes     paquetes    @relation(fields: [paquete_id], references: [id])
  proveedores  proveedores @relation(fields: [proveedor_id], references: [id])
  empresa_id       Int @default(dbgenerated("COALESCE(NULLIF(current_setting('app.empresa_id', true), '')::int, 1)"))
  empresas         empresas @relation(fields: [empresa_id], references: [id])

  @@index([empresa_id])
}

model paquete_tarifas {
  id             Int           @id @default(autoincrement())
  paquete_id     Int
  tarifa_adulto  Float         @default(0)
  tarifa_menor   Float?
  vigencia_desde DateTime?
  vigencia_hasta DateTime?
  paquetes       paquetes      @relation(fields: [paquete_id], references: [id])
  prod_planes    prod_planes[]
  empresa_id       Int @default(dbgenerated("COALESCE(NULLIF(current_setting('app.empresa_id', true), '')::int, 1)"))
  empresas         empresas @relation(fields: [empresa_id], references: [id])

  @@index([empresa_id])
  // Necesario para que otras tablas puedan apuntar a esta fila con su empresa
  // dentro: sin este único, la clave ajena compuesta no se puede crear.
  @@unique([id, empresa_id])
}

model paquete_vuelo {
  id              Int         @id @default(autoincrement())
  paquete_id      Int
  aerolinea_id    Int?
  nro_vuelo       String?
  modo_vuelo      FlightMode? @default(round_trip)
  trayectos       Json?
  plan_equipaje   String?
  tipo_transporte String?     @default("Aereo")
  aerolineas      aerolineas? @relation(fields: [aerolinea_id], references: [id])
  paquetes        paquetes    @relation(fields: [paquete_id], references: [id])
  empresa_id       Int @default(dbgenerated("COALESCE(NULLIF(current_setting('app.empresa_id', true), '')::int, 1)"))
  empresas         empresas @relation(fields: [empresa_id], references: [id])

  @@index([empresa_id])
}

model paquetes {
  id                        Int                        @id @default(autoincrement())
  nombre                    String
  destino                   String
  servicios_incluidos       String?
  no_incluido               String?
  status                    EstadoPaquete              @default(activo)
  creado_por_id             Int?
  creado_at                 DateTime                   @default(now())
  deleted_at                DateTime?
  paquete_asistencia_medica paquete_asistencia_medica?
  paquete_hotel             paquete_hotel[]
  paquete_proveedor         paquete_proveedor[]
  paquete_tarifas           paquete_tarifas[]
  paquete_vuelo             paquete_vuelo[]
  usuarios                  usuarios?                  @relation(fields: [creado_por_id], references: [id])
  prod_planes               prod_planes[]
  empresa_id       Int @default(dbgenerated("COALESCE(NULLIF(current_setting('app.empresa_id', true), '')::int, 1)"))
  empresas         empresas @relation(fields: [empresa_id], references: [id])

  @@index([empresa_id])
  // Necesario para que otras tablas puedan apuntar a esta fila con su empresa
  // dentro: sin este único, la clave ajena compuesta no se puede crear.
  @@unique([id, empresa_id])
}

model pasajeros_detalle {
  id               String        @id
  detalle_venta_id String
  persona_id       Int
  es_titular       Boolean?      @default(false)
  asiento          String?
  nro_reserva      String?
  nro_tiquete      String?
  nota             String?
  detalle_venta    detalle_venta @relation(fields: [detalle_venta_id], references: [id])
  personas         personas      @relation(fields: [persona_id], references: [id])

  empresa_id       Int @default(dbgenerated("COALESCE(NULLIF(current_setting('app.empresa_id', true), '')::int, 1)"))
  empresas         empresas @relation(fields: [empresa_id], references: [id])

  @@index([empresa_id])
  @@index([detalle_venta_id])
  @@index([persona_id])
}

model permisos {
  id               Int                @id @default(autoincrement())
  modulo           String
  accion           String
  descripcion      String?
  permisos_rol     permisos_rol[]
}

model permisos_rol {
  id         Int      @id @default(autoincrement())
  rol_id     Int
  permiso_id Int
  valor      String   @default("true")
  permisos   permisos @relation(fields: [permiso_id], references: [id])
  roles      roles    @relation(fields: [rol_id], references: [id])

  empresa_id       Int @default(dbgenerated("COALESCE(NULLIF(current_setting('app.empresa_id', true), '')::int, 1)"))
  empresas         empresas @relation(fields: [empresa_id], references: [id])

  @@index([empresa_id])
  @@unique([rol_id, permiso_id])
}


model personas {
  id                Int                 @id @default(autoincrement())
  nombres           String
  apellidos         String
  tipo_documento_id Int?
  documento         String?
  email             String?
  telefono          String?
  birth_date        DateTime?
  nacionalidad      String?
  avatar_url        String?
  status            UserStatus          @default(active)
  creado_at         DateTime            @default(now())
  updated_at        DateTime?
  deleted_at        DateTime?
  clientes          clientes?
  comisionistas     comisionistas?
  pasajeros_detalle pasajeros_detalle[]
  tipos_documento   tipos_documento?    @relation(fields: [tipo_documento_id], references: [id])
  responsables      responsables?
  usuarios          usuarios?
  empresa_id       Int @default(dbgenerated("COALESCE(NULLIF(current_setting('app.empresa_id', true), '')::int, 1)"))
  empresas         empresas @relation(fields: [empresa_id], references: [id])

  @@unique([empresa_id, documento])
  @@index([empresa_id])
  // Necesario para que otras tablas puedan apuntar a esta fila con su empresa
  // dentro: sin este único, la clave ajena compuesta no se puede crear.
  @@unique([id, empresa_id])
}

model politicas_equipaje {
  id                Int               @id @default(autoincrement())
  aerolinea_id      Int
  tipo_tarifa       String
  articulo_personal String?
  equipaje_mano     String?
  equipaje_bodega   String?
  notas             String?
  aerolineas        aerolineas        @relation(fields: [aerolinea_id], references: [id])
  prod_tiqueteria   prod_tiqueteria[]
  tramos_vuelo      tramos_vuelo[]
}

model prod_autos {
  id                      String        @id
  detalle_venta_id        String        @unique
  conductor_nombre        String?
  licencia_nro            String?
  fecha_recogida          DateTime?
  fecha_devolucion        DateTime?
  lugar_recogida          String?
  categoria_auto          String?
  conductores_adicionales Int?          @default(0)
  tipo_seguro             String?
  tarjeta_garantia_info   String?
  detalle_venta           detalle_venta @relation(fields: [detalle_venta_id], references: [id])
  empresa_id       Int @default(dbgenerated("COALESCE(NULLIF(current_setting('app.empresa_id', true), '')::int, 1)"))
  empresas         empresas @relation(fields: [empresa_id], references: [id])

  @@index([empresa_id])
}

model prod_checkins {
  id                     String        @id
  detalle_venta_id       String        @unique
  nro_vuelo_reserva      String?
  fecha_viaje            DateTime?
  asiento                String?
  maletas_contadas       String?
  telefono_contacto      String?
  necesidades_especiales String?
  usa_silla_ruedas       Boolean?      @default(false)
  detalle_venta          detalle_venta @relation(fields: [detalle_venta_id], references: [id])
  empresa_id       Int @default(dbgenerated("COALESCE(NULLIF(current_setting('app.empresa_id', true), '')::int, 1)"))
  empresas         empresas @relation(fields: [empresa_id], references: [id])

  @@index([empresa_id])
}

model prod_eventos {
  id                  String        @id
  detalle_venta_id    String        @unique
  organizacion        String?
  nombre_contacto     String?
  email_contacto      String?
  fechaInicio         DateTime?
  fechaFin            DateTime?
  asistencia_estimada Int?
  espacio_requerido   String?
  tipo_evento         String?
  equipos_av          String?
  requiere_catering   Boolean?      @default(false)
  notas_catering      String?
  ciudad              String?       @db.VarChar(40)
  direccion           String?       @db.VarChar(40)
  nombre_lugar        String?       @db.VarChar(40)
  detalle_venta       detalle_venta @relation(fields: [detalle_venta_id], references: [id])
  empresa_id       Int @default(dbgenerated("COALESCE(NULLIF(current_setting('app.empresa_id', true), '')::int, 1)"))
  empresas         empresas @relation(fields: [empresa_id], references: [id])

  @@index([empresa_id])
}

model prod_fincas {
  id                    String        @id
  detalle_venta_id      String        @unique
  responsable_nombre    String?
  documento_responsable String?
  fecha_entrada         DateTime?
  fecha_salida          DateTime?
  adultos_count         Int?
  ninos_count           Int?
  tiene_mascotas        Boolean?      @default(false)
  tipo_mascota          String?
  servicios_extra       String?
  nombre_finca          String?
  direccion_finca       String?
